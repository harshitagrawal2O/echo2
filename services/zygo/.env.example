# Zygo merchant key: `client_id:secret` from the Zygo app (Profile -> Developer mode).
# Shown once. Never commit it, never put it in the APK, never paste it into chat.
ZYGO_API_KEY=

# "sandbox" (default) or "live". Absent means sandbox: a payments service must not go live
# because someone forgot a variable.
ZYGO_ENVIRONMENT=sandbox

# Bearer token the Android app presents. Abuse gate, not a secret - it ships in the APK.
# See lib/http.js for what it is and is not worth.
ZYGO_PROXY_TOKEN=

# Solana RPC used only to build the unsigned deposit transaction. No key is ever loaded here.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional ceiling on a single payment, in paise. Default 200000 (INR 2000.00).
ZYGO_MAX_FIAT_MINOR=200000
